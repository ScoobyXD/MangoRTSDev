+++ b/infra/aws-qa/checks.tf
@@ -0,0 +1,46 @@
+check "nylas_core_is_all_or_none" {
+  assert {
+    condition     = contains([0, 3], local.nylas_core_configured_count)
+    error_message = "Set all or none of nylas_client_id, nylas_api_key_secret_arn, and nylas_state_secret_arn."
+  }
+}
+
+check "nylas_webhook_requires_core" {
+  assert {
+    condition     = trimspace(var.nylas_webhook_secret_arn) == "" || local.nylas_core_configured_count == 3
+    error_message = "nylas_webhook_secret_arn requires the complete QA Nylas core configuration."
+  }
+}
+
+check "email_worker_dependencies" {
+  assert {
+    condition = !var.email_worker_enabled || (
+      var.realtime_valkey_enabled &&
+      var.email_sqs_database_migration_complete &&
+      local.nylas_core_configured_count == 3 &&
+      trimspace(var.backend_image_uri) != ""
+    )
+    error_message = "email_worker_enabled requires an immutable backend image, Valkey, the reviewed database schema, and complete QA Nylas core configuration."
+  }
+}
+
+check "full_alarms_require_container_insights" {
+  assert {
+    condition     = !var.cloudwatch_alarms_enabled || var.ecs_container_insights_enabled
+    error_message = "The full QA alarm set requires ECS Container Insights for the email-worker running-task alarm."
+  }
+}
+
+check "qa_identity_is_hard_locked" {
+  assert {
+    condition = (
+      local.project_name == "mangorts" &&
+      local.environment == "qa" &&
+      local.root_domain_name == "mangorts.com" &&
+      local.app_subdomain == "qa" &&
+      local.api_subdomain == "api.qa" &&
+      local.origin_subdomain == "origin.qa"
+    )
+    error_message = "QA project, environment, and DNS identity must remain hard-locked."
+  }
+}
diff --git a/infra/aws-qa/database.tf b/infra/aws-qa/database.tf
new file mode 100644
index 00000000..a8bf1497
--- /dev/null
+++ b/infra/aws-qa/database.tf
@@ -0,0 +1,71 @@
+resource "aws_security_group" "database" {
+  name                   = "${local.name_prefix}-postgres"
+  description            = "Private MangoRTS QA PostgreSQL access"
+  vpc_id                 = var.vpc_id
+  revoke_rules_on_delete = true
+
+  tags = merge(local.tags, {
+    Name = "${local.name_prefix}-postgres"
+  })
+}
+
+resource "aws_db_subnet_group" "qa" {
+  name       = "${local.name_prefix}-postgres"
+  subnet_ids = var.private_subnet_ids
+
+  tags = merge(local.tags, {
+    Name = "${local.name_prefix}-postgres"
+  })
+}
+
+resource "aws_db_instance" "qa" {
+  identifier = "${local.name_prefix}-postgres"
+
+  engine         = "postgres"
+  engine_version = var.database_engine_version
+  instance_class = var.database_instance_class
+
+  allocated_storage     = var.database_allocated_storage_gb
+  max_allocated_storage = var.database_max_allocated_storage_gb
+  storage_type          = "gp3"
+  storage_encrypted     = true
+
+  db_name                     = var.database_name
+  username                    = var.database_user
+  manage_master_user_password = true
+  port                        = 5432
+
+  db_subnet_group_name   = aws_db_subnet_group.qa.name
+  vpc_security_group_ids = [aws_security_group.database.id]
+  publicly_accessible    = false
+  multi_az               = false
+
+  auto_minor_version_upgrade  = true
+  allow_major_version_upgrade = false
+  apply_immediately           = false
+
+  backup_retention_period  = var.database_backup_retention_days
+  copy_tags_to_snapshot    = true
+  delete_automated_backups = true
+  deletion_protection      = var.database_deletion_protection
+  skip_final_snapshot      = true
+
+  performance_insights_enabled = false
+  monitoring_interval          = 0
+
+  tags = merge(local.tags, {
+    Name = "${local.name_prefix}-postgres"
+  })
+
+  lifecycle {
+    precondition {
+      condition     = length(var.private_subnet_ids) >= 2
+      error_message = "QA PostgreSQL requires at least two existing private subnets in the shared VPC."
+    }
+
+    precondition {
+      condition     = var.database_max_allocated_storage_gb == 0 || var.database_max_allocated_storage_gb >= var.database_allocated_storage_gb
+      error_message = "database_max_allocated_storage_gb must be zero or at least database_allocated_storage_gb."
+    }
+  }
+}
diff --git a/infra/aws-qa/database_migration_task.tf b/infra/aws-qa/database_migration_task.tf
new file mode 100644
index 00000000..8467c36b
--- /dev/null
+++ b/infra/aws-qa/database_migration_task.tf
@@ -0,0 +1,54 @@
+resource "aws_cloudwatch_log_group" "database_migration" {
+  name              = "/ecs/${local.name_prefix}/database-migration"
+  retention_in_days = var.cloudwatch_log_retention_days
+}
+
+resource "aws_ecs_task_definition" "database_migration" {
+  count = trimspace(var.migration_image_uri) != "" ? 1 : 0
+
+  family                   = "${local.name_prefix}-database-migration"
+  network_mode             = "awsvpc"
+  requires_compatibilities = ["FARGATE"]
+  cpu                      = 256
+  memory                   = 512
+  execution_role_arn       = module.platform.ecs_task_execution_role_arn
+  tags                     = local.tags
+  skip_destroy             = true
+
+  container_definitions = jsonencode([
+    {
+      name      = "database-migration"
+      image     = var.migration_image_uri
+      essential = true
+
+      # A task started without an explicit reviewed override can only inspect.
+      # Fresh QA initialization must deliberately override this with:
+      # -mode schema -baseline-migrations
+      command = ["-mode", "audit"]
+
+      environment = [
+        { name = "DB_HOST", value = aws_db_instance.qa.address },
+        { name = "DB_PORT", value = tostring(aws_db_instance.qa.port) },
+        { name = "DB_NAME", value = var.database_name },
+        { name = "DB_USER", value = var.database_user },
+        { name = "DB_SSLMODE", value = "require" }
+      ]
+
+      secrets = [
+        {
+          name      = "DB_PASSWORD"
+          valueFrom = "${aws_db_instance.qa.master_user_secret[0].secret_arn}:password::"
+        }
+      ]
+
+      logConfiguration = {
+        logDriver = "awslogs"
+        options = {
+          awslogs-group         = aws_cloudwatch_log_group.database_migration.name
+          awslogs-region        = var.aws_region
+          awslogs-stream-prefix = "ecs"
+        }
+      }
+    }
+  ])
+}
diff --git a/infra/aws-qa/iam.tf b/infra/aws-qa/iam.tf
new file mode 100644
index 00000000..a6381908
--- /dev/null
+++ b/infra/aws-qa/iam.tf
@@ -0,0 +1,42 @@
+data "aws_iam_policy_document" "qa_terraform_state" {
+  statement {
+    sid       = "ReadQAStateBucketMetadata"
+    actions   = ["s3:GetBucketLocation"]
+    resources = ["arn:${data.aws_partition.current.partition}:s3:::${var.terraform_state_bucket_name}"]
+  }
+
+  statement {
+    sid       = "ListExactQAStateObjects"
+    actions   = ["s3:ListBucket"]
+    resources = ["arn:${data.aws_partition.current.partition}:s3:::${var.terraform_state_bucket_name}"]
+
+    condition {
+      test     = "StringLike"
+      variable = "s3:prefix"
+      values   = [local.terraform_state_key, "${local.terraform_state_key}.tflock"]
+    }
+  }
+
+  statement {
+    sid = "ManageExactQAStateObjects"
+    actions = [
+      "s3:DeleteObject",
+      "s3:GetObject",
+      "s3:PutObject"
+    ]
+    resources = [
+      "arn:${data.aws_partition.current.partition}:s3:::${var.terraform_state_bucket_name}/${local.terraform_state_key}",
+      "arn:${data.aws_partition.current.partition}:s3:::${var.terraform_state_bucket_name}/${local.terraform_state_key}.tflock"
+    ]
+  }
+}
+
+resource "aws_iam_policy" "qa_terraform_state" {
+  name   = "${local.name_prefix}-github-deploy-state"
+  policy = data.aws_iam_policy_document.qa_terraform_state.json
+}
+
+resource "aws_iam_role_policy_attachment" "qa_terraform_state" {
+  role       = module.platform.github_deploy_role_name
+  policy_arn = aws_iam_policy.qa_terraform_state.arn
+}
