APP_ENV=staging
ALLOW_INMEMORY_FALLBACK=false
MANGORTS_ADDR=:8080
MANGORTS_ALLOWED_ORIGIN=*
NYLAS_CLIENT_ID=
NYLAS_API_KEY=
NYLAS_API_BASE_URL=https://api.us.nylas.com
NYLAS_REDIRECT_URI=http://localhost:8080/nylas/oauth/callback
NYLAS_FRONTEND_REDIRECT_URL=http://localhost:5173/communications
NYLAS_STATE_SECRET=replace-with-long-random-secret
NYLAS_WEBHOOK_SECRET=replace-with-nylas-webhook-secret
NYLAS_GOOGLE_SCOPES=https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/gmail.modify https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/gmail.labels
NYLAS_MICROSOFT_SCOPES=offline_access User.Read Mail.ReadWrite Mail.Send

AUTH_MODE=disabled
AWS_REGION=us-west-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_TOKEN_USE=access,id

DB_HOST=your-aurora-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace-me
DB_NAME=postgres
DB_SSLMODE=require
