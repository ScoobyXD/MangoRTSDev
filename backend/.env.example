APP_ENV=staging
ALLOW_INMEMORY_FALLBACK=false
MANGORTS_ADDR=:8080
MANGORTS_ALLOWED_ORIGIN=*

AUTH_MODE=disabled
AWS_REGION=us-west-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_TOKEN_USE=access,id

DB_HOST=your-aurora-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace-me
DB_NAME=postgres
DB_SSLMODE=require
