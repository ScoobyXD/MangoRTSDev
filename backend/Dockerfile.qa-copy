FROM postgres:17.11-bookworm

ARG MANGORTS_GIT_COMMIT
RUN printf '%s\n' "$MANGORTS_GIT_COMMIT" | grep -Eq '^[0-9a-f]{40}$' \
    && install -d -o postgres -g postgres -m 0700 /work

COPY --chmod=0555 scripts/qa_fargate_copy_entrypoint.sh /usr/local/bin/mangorts-qa-copy

ENV MANGORTS_QA_COPY_IMAGE_COMMIT=$MANGORTS_GIT_COMMIT
LABEL org.opencontainers.image.revision=$MANGORTS_GIT_COMMIT

USER postgres
ENTRYPOINT ["/usr/local/bin/mangorts-qa-copy"]
