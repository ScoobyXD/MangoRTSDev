FROM golang:1.25 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/miraeopus-migrate ./cmd/miraeopus-migrate

FROM gcr.io/distroless/base-debian12
WORKDIR /app
COPY --from=build /out/miraeopus-migrate /miraeopus-migrate
COPY --from=build /src/db /app/db
ENTRYPOINT ["/miraeopus-migrate"]
