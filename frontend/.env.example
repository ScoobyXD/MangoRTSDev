VITE_API_BASE_URL=http://localhost:8080
VITE_COMPANY_ID=11111111-1111-1111-1111-111111111111

# Local dev keeps auth disabled unless you intentionally test Cognito.
VITE_AUTH_MODE=disabled
VITE_COGNITO_REGION=us-west-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# Required for Project and Logic Gate JSON editors. They use Yjs collaboration
# exclusively and never fall back to whole-document editor JSON writes.
# Node v2 also requires this endpoint when VITE_NODE_V2_PHASE2=true.
VITE_NODE_V2_COLLAB_URL=
VITE_NODE_V2_PHASE2=false
