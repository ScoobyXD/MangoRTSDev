aws_region  = "us-west-1"
project_name = "mangorts"
environment  = "dev"

root_domain_name = "example.com"
app_subdomain    = "dev"
api_subdomain    = "api.dev"
origin_subdomain = "origin.dev"

# Use the VPC that contains the existing dev PostgreSQL/Aurora DB.
vpc_id = "vpc-0123456789abcdef0"

# Existing public subnets for ALB and NAT placement.
public_subnet_ids = ["subnet-aaaaaaaaaaaaaaaaa", "subnet-bbbbbbbbbbbbbbbbb"]

# Preferred when the existing VPC does not already have private app subnets.
create_private_ecs_subnets = true
ecs_private_subnet_cidrs   = ["172.31.128.0/20", "172.31.144.0/20"]
ecs_nat_gateway_mode       = "single"
private_subnet_ids         = []

# If you already have private subnets with NAT/VPC-endpoint egress, use this instead:
# create_private_ecs_subnets = false
# private_subnet_ids = ["subnet-ccccccccccccccccc", "subnet-ddddddddddddddddd"]

existing_db_host                = "dev-db.cluster-xxxxxxxx.us-west-1.rds.amazonaws.com"
existing_db_port                = 5432
existing_db_name                = "mangorts"
existing_db_user                = "mangorts_app"
existing_db_password_secret_arn = "arn:aws:secretsmanager:us-west-1:123456789012:secret:mangorts/dev/db-password"
existing_db_security_group_id   = "sg-0123456789abcdef0"

# Phase-1 bootstrap should keep this empty. CI sets an immutable git-SHA image URI after ECR exists.
backend_image_uri = ""

# Normal DEV deploy: run the API, queues, and one private worker together.
# Keep the rare reconciliation schedule off until it is intentionally enabled.
email_sqs_enabled                     = true
email_worker_enabled                  = true
email_sqs_database_migration_complete = true
email_reconciliation_schedule_enabled = false
email_worker_concurrency              = 3
email_worker_cpu                      = 1024
email_worker_memory                   = 2048
email_worker_alarm_action_arns        = [] # Optional SNS/incident destinations; CloudWatch alarms still exist when this is empty.

# Private, TLS-only, IAM-authenticated Valkey Pub/Sub backplane for committed
# realtime outbox events. No cache password or other secret is stored in tfvars.
realtime_valkey_enabled              = true
realtime_valkey_channel              = "mangorts:realtime:v1"
realtime_valkey_major_engine_version = "7"
realtime_valkey_max_data_storage_gb  = 1
realtime_valkey_max_ecpu_per_second  = 1000
realtime_valkey_alarm_action_arns    = []

# Private attachment storage and browser-to-S3 control-plane policy. The bucket
# CORS/lifecycle configuration is Terraform-owned after an approved apply.
attachment_s3_bucket                      = "mangorts-dev-attachments"
attachment_direct_upload_enabled          = true
attachment_max_browser_upload_bytes       = 1073741824 # 1 GiB
attachment_upload_intent_ttl_seconds       = 86400     # 24 hours
attachment_single_put_url_ttl_seconds      = 3600      # 60 minutes
attachment_multipart_part_url_ttl_seconds = 900       # 15 minutes
attachment_s3_presign_endpoint             = ""        # Set only for a browser-reachable custom endpoint.
attachment_additional_browser_origins      = []        # Dev app origin and http://localhost:5173 are automatic.
attachment_multipart_abort_days            = 2

default_company_id = "11111111-1111-1111-1111-111111111111"

# Deprecated compatibility alias accepted by the dev root:
# dev_company_id = "11111111-1111-1111-1111-111111111111"

# Must be verified in SES in aws_region before signup confirmation emails are enabled.
email_from_address = "no-reply@example.com"

# Use only for the first dev admin bootstrap deploy, then clear it.
bootstrap_admin_emails = ""
bootstrap_company_name  = "MangoRTS Bootstrap"

# Deprecated compatibility aliases accepted by the dev root:
# bootstrap_dev_admin_emails = ""
# bootstrap_dev_company_name  = "MangoRTS Bootstrap"

# Nylas Communications. Keep secret values in AWS Secrets Manager and pass ARNs here.
# Register https://api.dev.example.com/nylas/oauth/callback as the Hosted OAuth callback.
# Register https://api.dev.example.com/nylas/webhook as a webhook destination, then store
# the returned webhook_secret in Secrets Manager and set nylas_webhook_secret_arn.
nylas_client_id            = "00000000-0000-0000-0000-000000000000"
nylas_api_base_url         = "https://api.us.nylas.com"
nylas_api_key_secret_arn   = "arn:aws:secretsmanager:us-west-1:123456789012:secret:mangorts/dev/nylas-api-key"
nylas_state_secret_arn     = "arn:aws:secretsmanager:us-west-1:123456789012:secret:mangorts/dev/nylas-state-secret"
nylas_webhook_secret_arn   = "arn:aws:secretsmanager:us-west-1:123456789012:secret:mangorts/dev/nylas-webhook-secret"
nylas_google_scopes        = "https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/gmail.modify https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/gmail.labels"
nylas_microsoft_scopes     = "offline_access User.Read Mail.ReadWrite Mail.Send"

# Deprecated from the Hosted UI flow; keep a placeholder until the variable is removed.
cognito_domain_prefix = "unused-custom-auth"

# Shared secret material used only for CloudFront-to-ALB origin verification.
# This does not create a browser-visible Basic Auth gate.
origin_verify_secret = "replace-with-a-random-origin-secret"

github_owner      = "your-github-owner"
github_repository = "MangoRTSDev"
github_branch     = "main"

extra_tags = {
  owner = "you"
  team  = "platform"
}
