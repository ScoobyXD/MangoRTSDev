aws_region = "us-west-1"

# QA identity and DNS are hard-locked in Terraform to mangorts/qa and
# qa.mangorts.com, api.qa.mangorts.com, and origin.qa.mangorts.com.
terraform_state_bucket_name = "replace-with-existing-private-state-bucket"

# Reuse the existing VPC, public ALB subnets, private ECS subnets, and NAT egress.
vpc_id            = "vpc-0123456789abcdef0"
public_subnet_ids  = ["subnet-aaaaaaaaaaaaaaaaa", "subnet-bbbbbbbbbbbbbbbbb"]
private_subnet_ids = ["subnet-ccccccccccccccccc", "subnet-ddddddddddddddddd"]

# Lowest-cost isolated database defaults: private PostgreSQL 17, Single-AZ,
# 20 GiB gp3, RDS-managed password, no Performance Insights or enhanced monitoring.
database_engine_version          = "17.7"
database_instance_class          = "db.t4g.micro"
database_allocated_storage_gb    = 20
database_max_allocated_storage_gb = 0
database_backup_retention_days   = 1
database_deletion_protection     = true
database_name                    = "mangorts_qa"

# This example shows the final production-shaped QA state. Replace image and
# Nylas placeholders before using it. The README lists the explicit overrides
# for the first infrastructure-only plan, when the image and schema do not exist.
backend_image_uri                     = "123456789012.dkr.ecr.us-west-1.amazonaws.com/mangorts-qa-backend:replace-with-git-sha"
migration_image_uri                   = "123456789012.dkr.ecr.us-west-1.amazonaws.com/mangorts-qa-backend:replace-with-git-sha-migrations"
backend_cpu                           = 512
backend_memory                        = 1024
backend_desired_count                 = 1
email_sqs_database_migration_complete = true

# Keep mail processing off until separate QA Nylas credentials and controlled
# mailboxes are configured.
email_worker_enabled                  = false
email_reconciliation_schedule_enabled = false
email_worker_concurrency              = 1
email_worker_cpu                      = 256
email_worker_memory                   = 512
email_worker_alarm_action_arns        = []

# Private IAM-authenticated Valkey is required by the API realtime path and worker.
realtime_valkey_enabled             = true
realtime_valkey_max_data_storage_gb = 1
realtime_valkey_max_ecpu_per_second = 1000
realtime_valkey_alarm_action_arns   = []

# Empty derives mangorts-qa-attachments-<aws-account-id>.
attachment_s3_bucket = ""

# Supply the fresh QA company UUID after bootstrap.
default_company_id = "11111111-1111-1111-1111-111111111111"

# Keep SES disabled until a QA sender is intentionally selected.
email_from_address     = ""
bootstrap_admin_emails = ""
bootstrap_company_name = "Mango QA"

# Separate QA Nylas app and Secrets Manager ARNs. Never reuse live grants or keys.
nylas_client_id            = "00000000-0000-0000-0000-000000000000"
nylas_api_base_url         = "https://api.us.nylas.com"
nylas_api_key_secret_arn   = "arn:aws:secretsmanager:us-west-1:123456789012:secret:mangorts/qa/nylas-api-key"
nylas_state_secret_arn     = "arn:aws:secretsmanager:us-west-1:123456789012:secret:mangorts/qa/nylas-state-secret"
nylas_webhook_secret_arn   = "arn:aws:secretsmanager:us-west-1:123456789012:secret:mangorts/qa/nylas-webhook-secret"
# QA-only CloudFront-to-ALB verification material. Do not commit a real value.
origin_verify_secret = "replace-with-a-random-qa-only-secret"

# Production-shaped QA protection and observability. Empty alarm-action lists
# still create alarms; supply existing SNS/incident ARNs if notifications are wanted.
cloudwatch_log_retention_days = 7
ecs_container_insights_enabled = true
cloudwatch_alarms_enabled       = true
waf_enabled                     = true

github_owner             = "your-github-owner"
github_repository        = "MangoRTSDev"
github_oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"

extra_tags = {
  owner = "you"
  team  = "platform"
}
