# The API builds from the repository root.
# Only source/dependency manifests needed by this image enter its context.
**
!backend/go.mod
!backend/go.sum
# Docker traverses excluded directories only for explicit exception prefixes.
# Include the source directory here when the API imports a new local package.
!backend/cmd/miraeopus-api/*.go
!backend/internal/attachmentcleanup/*.go
!backend/internal/attachments/migration/*.go
!backend/internal/auth/*.go
!backend/internal/ctrlloopexcel/*.go
!backend/internal/domain/*.go
!backend/internal/emailqueue/*.go
!backend/internal/http/*.go
!backend/internal/notifications/*.go
!backend/internal/openaiagents/*.go
!backend/internal/realtime/*.go
!backend/internal/sourceaudit/*.go
!backend/internal/store/*.go
**/*_test.go
**/*.test.mjs
**/node_modules
**/testdata
**/.git
**/.env*
backend/db
docs
infra
frontend
scripts
